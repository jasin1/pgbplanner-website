---
export const prerender = true;

import { type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPostLayout from "../../components/blog/BlogPostLayout.astro";
import { getPublishedPosts } from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<"blog"> };

const { post } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout
  title={`${post.data.title} • PGB Planner`}
  titleTag={post.data.titleTag ? `${post.data.titleTag} • PGB Planner` : undefined}
  description={post.data.description}
  ogType="article"
  ogImage={post.data.image}
>
  <BlogPostLayout title={post.data.title} pubDate={post.data.pubDate}>
    <Content />
  </BlogPostLayout>
</BaseLayout>
