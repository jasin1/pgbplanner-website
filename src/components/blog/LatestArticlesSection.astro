---
import { getPublishedPosts, isBlogIndexThresholdMet, getHeroImageSrc } from "../../lib/blog";
import BlogCard from "./BlogCard.astro";

const allPosts = await getPublishedPosts();
const posts = allPosts.slice(0, 3);
const showAllLink = await isBlogIndexThresholdMet();
---

{allPosts.length > 0 && (
  <section class="flex-center latest-articles">
    <div class="container">
      <div class="latest-articles__heading">
        <h2>Laatste artikelen</h2>
      </div>

      <div class="latest-articles__grid">
        {posts.map((post) => (
          <BlogCard
            href={`/blog/${post.slug}/`}
            heroSrc={getHeroImageSrc(post.id)}
            heroAlt={post.data.heroAlt ?? ""}
            pubDate={post.data.pubDate}
            title={post.data.title}
            teaser={post.data.teaser ?? post.data.description}
          />
        ))}
      </div>

      {showAllLink && (
        <div class="latest-articles__all">
          <a class="btn btn-primary" href="/blog/">Bekijk alle artikelen</a>
        </div>
      )}
    </div>
  </section>
)}

<style>
  .latest-articles__heading {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .latest-articles__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .latest-articles__all {
    display: flex;
    justify-content: center;
    margin-top: 3.5rem;
  }

  .latest-articles__all .btn {
    display: inline-flex;
    align-items: center;
  }
</style>
